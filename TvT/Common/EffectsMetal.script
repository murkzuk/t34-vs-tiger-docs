//Calibre 7576_85_88
class CCalibre7576_85_88BulletMetalHitSplashEffect
  extends CAnimatedParticleGenerator
{
  CCalibre7576_85_88BulletMetalHitSplashEffect()
  {
    SetCoordSystemType(CRDSYS_Local);

    SetAnimationTime(0.5);
    SetEffectTime(0.5);
    SetPlaceParams(0.2);

    SetBaseColor(new Color(1.0, 0.9, 0.1, 0.5));
    SetSizeParams(0.4, 0.2);
    SetStartAndFinalFade(0.0, 0.4, 0.5);
    for (int I = 0; I < 4; I++)
    {
      SetAnimLength(48);
      SetFixedMaterial(new String(I));

      GenerateAnimatedParticle(
          CEffectsArray::SplashCloudLiteEffectSkin, 0, 1.0,
          new Vector(0.0, 0.0, 0.1), new Vector(0.0, 0.0, 1.0 + I),
          new Vector(0.0, 0.0, 0.0), new Vector(5.0 + I, 5.0 + I, 5.0 + I)
        );
    }

  }
}

// Spall/fragment debris on armor hit - uses MetalDebrisEffectSkin (already
// registered in EffectsArray, previously unused by any effect). Same
// gravity+rotation "spray" pattern as CCalibre7576_85_88BulletWoodHitDebrisEffect,
// loop bound comes from Materials.size() so it can never outrun the texture's
// actual frame count.
class CCalibre7576_85_88BulletMetalHitDebrisEffect
  extends CAnimatedParticleGenerator
{
  Vector  StartPlace = new Vector(0.0, 0.0, 0.0);
  Vector  FinalPlace = new Vector(0.0, 0.0, 0.0);
  Vector  StartSize  = new Vector(0.35, 0.35, 0.35);
  Vector  FinalSize  = new Vector(0.35, 0.35, 0.35);

  CCalibre7576_85_88BulletMetalHitDebrisEffect()
  {
    SetAnimationTime(0.8);
    SetEffectTime(0.8);

    SetSamplesQty(32);
    SetSpeed(10.0, 16.0);
    SetDirection(new Vector(0.0, 0.0, 1.0), 0.0, 35.0);
    SetStartAndFinalFade(0.0, 0.7);
    SetGravity(CWorldPhysics::GravityVector);
    SetRotation(0.0, 720.0);
    SetSizeParams(1.0, 1.0);

    final int SamplesQty =
      CEffectsArray::MetalDebrisEffectSkin.Materials.size();

    m_AnimLength = 16;

    for (int I = 0; I < SamplesQty; I++)
    {
      SetFixedMaterial(new String(I));
      GenerateSamples(CEffectsArray::MetalDebrisEffectSkin);
    }
  }

  GenerateSamples(
      Component _SkinClass
    )
  {
    GenerateAnimatedParticle(
        _SkinClass, 0, 1.0,
        StartPlace, FinalPlace,
        StartSize, FinalSize
      );
  }
}

class CCalibre7576_85_88BulletMetalHitSmokeEffect
 extends CAnimatedParticleGenerator
{
  CCalibre7576_85_88BulletMetalHitSmokeEffect()
  {
    SetCoordSystemType(CRDSYS_Local);

    SetAnimationTime(3.2);
    SetEffectTime(3.2);
    SetPlaceParams(0.1);

    for (int I = 0; I < 2; I++)
    {
      SetStartAndFinalFade(0.1, 0.5);
      SetSizeParams(1.0, 0.2);
      SetBaseColor(new Color(68.0 / 255.0, 66.0 / 255.0, 55.0 / 255.0, 0.80000));
      SetAnimLength(32);
      SetFixedMaterial(new String(randnum(15)));

      GenerateAnimatedParticle(
          CEffectsArray::GroundDustEffectSkin, 0, 1.0,
          new Vector(0.0, 0.0, 0.0), new Vector(0.0, 0.0, 2.0),
          new Vector(0.0, 0.0, 0.0), new Vector(1.0, 1.0, 2.5)
        );
    }

    SetBaseColor(new Color(98.0 / 255.0, 95.0 / 255.0, 79.0 / 255.0, 0.65000));
    SetSizeParams(1.0, 0.2);
    SetStartAndFinalFade(0.1, 0.7);
    for (int I = 0; I < 12; I++)
    {
      SetAnimLength(48);
      SetFixedMaterial(new String(I));

      GenerateAnimatedParticle(
          CEffectsArray::GroundDustEffectSkin, 0, 1.0,
          new Vector(0.0, 0.0, 0.1), new Vector(rand(-2.0, 2.0), rand(-2.0, 2.0), float(randnum(2)) + 1.0),
          new Vector(0.0, 0.0, 0.0), new Vector(rand(1.0, 2.0), rand(1.0, 2.0), rand(1.0, 2.0))
        );
    }

    SetSizeParams(0.8, 0.75);
    for (int I = 0; I < 8; I++)
    {
      SetAnimLength(48);
      SetFixedMaterial(new String(I));
      GenerateAnimatedParticle(
          CEffectsArray::GroundDustEffectSkin, 0, 1.0,
          new Vector(0.0, 0.0, 0.1), new Vector(rand(-1.0, 1.0), rand(-1.0, 1.0), rand(0.0, 2.0)),
          new Vector(0.0, 0.0, 0.0), new Vector(rand(1.0, 2.0), rand(1.0, 2.0), rand(1.0, 2.0))
        );
    }

    SetSizeParams(0.5, 0.75);
    for (int I = 0; I < 5; I++)
    {
      SetAnimLength(48);
      SetFixedMaterial(new String(I));
      GenerateAnimatedParticle(
          CEffectsArray::GroundDustEffectSkin, 0, 1.0,
          new Vector(0.0, 0.0, 0.1), new Vector(rand(-0.5, 0.5), rand(-0.5, 0.5), rand(0.0, 0.5)),
          new Vector(0.0, 0.0, 0.0), new Vector(rand(1.0, 2.0), rand(1.0, 2.0), rand(1.0, 2.0))
        );
    }
  }
}

