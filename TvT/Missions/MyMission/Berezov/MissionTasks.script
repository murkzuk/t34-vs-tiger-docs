    m_EnemyReactionType == ERT_AGGRESSIVE;
  }
}

class BerezovKGKaiser extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }

  // Called from CBerezovMission::StartMission (delayed via sendEvent) -
  // matches the real mission's CombatScript: wait 1:00, then move by
  // road through Berezov to Gonki (the German main advance column).
  // Split into two single-point legs rather than one 2-point
  // SetOrder_MoveToEx call - every queued leg in SetOrder_MoveToEx
  // is tagged with the identical literal "MoveToEx" order name
  // regardless of array index, which broke routing entirely when
  // more than one point was queued at once (confirmed: every other
  // group's single-point call worked, this was the only 2-point one
  // and the only one that got stuck in an unreachable-path loop).
  event void StartAdvance()
  {
    SetOrder_MoveToEx([ new Vector(2150.0, 6328.0, 610.0) ], 10.0f);
  }

  event void StartAdvance2()
  {
    SetOrder_MoveToEx([ new Vector(5437.0, 6722.5, 610.0) ], 10.0f);
  }
}

class BerezovZugLex extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }

  // Called from CBerezovMission::OnObjectDestroyed (delayed via sendEvent)
  // once Plt.Samsonov's KillList hits zero - matches the real mission's
  // "CG State: Plt.Samsonov destroyed" trigger.
  event void StartAdvance()
  {
    SetOrder_MoveToEx([ new Vector(5437.0, 6722.5, 610.0) ], 10.0f);
  }
}

