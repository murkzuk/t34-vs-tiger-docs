class BerezovPltPopov extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }

  // Matches the real mission's unconditional "move to Zug Falke" order -
  // converges on wherever the player is when the timer fires.
  event void StartAdvance()
  {
    Component Player = GetMission().GetObject("MainPlayerUnit");
    if (Player != null)
      SetOrder_MoveToEx([ getPosition(Player).origin ], 10.0f);
  }
}

