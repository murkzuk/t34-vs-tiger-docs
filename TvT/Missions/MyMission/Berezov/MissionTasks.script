//--------------------------------------------------------------------------------
//Make Array KillList with ERT_AGGRESSIVE must attack ignored other units
//--------------------------------------------------------------------------------


//--------------------------------------------------------------------------------
// Shared base for every BerezovKursk group.
//
// CBaseUnitGroup's default OnPathEndReached() calls PopOrder() then
// RepeatOrder(), but PopOrder() returns early when the order stack is empty
// and leaves m_CurrentOrder.m_Order as "". The group is then permanently
// inert and logs "[ALARM] No orders in group ..." forever - it never moves
// again and never fights back on the move.
//
// Confirmed against shipped content: in Campaign_2\Mission_4 the five groups
// that override OnPathEndReached() all behave, while CC2M4Gr_AvantGuard76,
// which does not, hangs with that exact ALARM and never advances.
//
// Dropping into a defined stopped state keeps the group alive and able to
// engage, instead of leaving it in the undefined empty-order state.
//--------------------------------------------------------------------------------

class BerezovKurskBaseGroup extends CBaseUnitGroup
{
  // Fired by PositionWatchers.script when the German advance reaches a
  // trigger radius. Modelled on Campaign_2\Mission_4's CC2M4Gr_AvantGuard76.
  event void StartAttack()
  {
    logMessage(m_GroupID + ": StartAttack - engaging");
    ActivateRadar(true);
    ActivateFire(true);
    SetEnemyReactionType(ERT_AGGRESSIVE);
    SetOrder_Attack([GetMission().GetMainPlayerObjectID()], ERT_AGGRESSIVE);
  }

  void OnPathEndReached()
  {
    CBaseUnitGroup::OnPathEndReached();

    if (GetOrderName() == "")
    {
      logMessage(m_GroupID + ": path finished with an empty order stack - holding position");
      SetOrder_Stop();
    }
  }
}

class BerezovKurskZugFalke extends BerezovKurskBaseGroup
{
  float TankAttackSpeed = 10.0f;

  event void StartFirstAdvance()
  {
    isManeuver = false;
    ForEachUnitTask("ActivateBehavior", [true]);
    SetFormation("CFrontFormation", 50, true, true);
    ActivateRadar(true);
    SetEnemyReactionType(ERT_PASSIVE);

    Array ApproachPoints = [
                    GetNavPointBehPos("BerezovKurskAdvance_01"),
                    GetNavPointBehPos("BerezovKurskAdvance_02"),
                    GetNavPointBehPos("BerezovKurskAdvance_03"),
                    GetNavPointBehPos("BerezovKurskAdvance_04"),
                    GetNavPointBehPos("BerezovKurskAdvance_05"),
                    GetNavPointBehPos("BerezovKurskAdvance_06"),
                    GetNavPointBehPos("BerezovKurskAdvance_07"),
                    GetNavPointBehPos("BerezovKurskAdvance_08"),
                    GetNavPointBehPos("BerezovKurskAdvance_09"),
                    GetNavPointBehPos("BerezovKurskAdvance_10"),
                    GetNavPointBehPos("BerezovKurskAdvance_11"),
                    GetNavPointBehPos("BerezovKurskAdvance_12"),
                    GetNavPointBehPos("BerezovKurskAdvance_13"),
                    GetNavPointBehPos("BerezovKurskAdvance_14"),
                    GetNavPointBehPos("BerezovKurskAdvance_15"),
                    GetNavPointBehPos("BerezovKurskAdvance_16"),
                    GetNavPointBehPos("BerezovKurskAdvance_17"),
                    GetNavPointBehPos("BerezovKurskAdvance_18"),
                    GetNavPointBehPos("BerezovKurskAdvance_19"),
                    GetNavPointBehPos("BerezovKurskAdvance_20"),
                    GetNavPointBehPos("BerezovKurskAdvance_21"),
                    GetNavPointBehPos("BerezovKurskAdvance_22"),
                    GetNavPointBehPos("BerezovKurskAdvance_23"),
                    GetNavPointBehPos("BerezovKurskAdvance_24"),
                    GetNavPointBehPos("BerezovKurskAdvance_25"),
                    GetNavPointBehPos("BerezovKurskAdvance_26"),
                    GetNavPointBehPos("BerezovKurskAdvance_27"),
                    GetNavPointBehPos("BerezovKurskAdvance_28"),
                    GetNavPointBehPos("BerezovKurskAdvance_29"),
                    GetNavPointBehPos("BerezovKurskAdvance_30")
                           ];

//    SetFirstQueueOrders([
//      ["StartFirstAdvance", "SetOrder_MoveToEx", [ApproachPoints, TankAttackSpeed], ""],
//      ["StartFirstAdvance", "EndFirstAdvance_Attack", [], ""]
//                        ]);
  }

  void EndFirstAdvance_Attack()
  {
    SetEnemyReactionType(ERT_AGGRESSIVE);
//  SetFormation("CFrontFormation", 50, true, true);   // TEST 2026-08-18: suspected U-turn cause
    ActivateRadar(true);
  }
}

