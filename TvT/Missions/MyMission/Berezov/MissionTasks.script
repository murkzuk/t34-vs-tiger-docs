//--------------------------------------------------------------------------------
//Make Array KillList with ERT_AGGRESSIVE must attack ignored other units
//--------------------------------------------------------------------------------


class BerezovZugFalke extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }
}

class BerezovHQ extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }
}

class BerezovKGKaiser extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
    sendEvent(60.0, getIdentificator(this), "StartAdvance", []);
  }

  // Matches the real mission's CombatScript: wait 1:00, then move by
  // road through Berezov to Gonki (the German main advance column).
  void StartAdvance()
  {
    SetOrder_MoveToEx([
        new Vector(2150.0, 6328.0, 610.0),
        new Vector(5437.0, 6722.5, 610.0)
      ], 10.0f);
  }
}

class BerezovZugLex extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }

  // Called from CBerezovMission::OnObjectDestroyed once Plt.Samsonov's
  // KillList hits zero - matches the real mission's "CG State: Plt.Samsonov
  // destroyed" trigger.
  void TriggerAdvance()
  {
    sendEvent(90.0, getIdentificator(this), "StartAdvance", []);
  }

  void StartAdvance()
  {
    SetOrder_MoveToEx([ new Vector(5437.0, 6722.5, 610.0) ], 10.0f);
  }
}

