//--------------------------------------------------------------------------------
//Make Array KillList with ERT_AGGRESSIVE must attack ignored other units
//--------------------------------------------------------------------------------


class BerezovZugFalke extends CBaseUnitGroup
{
  float TankAttackSpeed = 10.0f;

  event void StartFirstAdvance()
  {
    ForEachUnitTask("ActivateBehavior", [true]);
    SetFormation("CFrontFormation", 50, true, true);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_PASSIVE;

    Array ApproachPoints = [
                    GetNavPointBehPos("BerezovAdvance_01"),
                    GetNavPointBehPos("BerezovAdvance_02"),
                    GetNavPointBehPos("BerezovAdvance_03"),
                    GetNavPointBehPos("BerezovAdvance_04"),
                    GetNavPointBehPos("BerezovAdvance_05"),
                    GetNavPointBehPos("BerezovAdvance_06"),
                    GetNavPointBehPos("BerezovAdvance_07"),
                    GetNavPointBehPos("BerezovAdvance_08"),
                    GetNavPointBehPos("BerezovAdvance_09"),
                    GetNavPointBehPos("BerezovAdvance_10"),
                    GetNavPointBehPos("BerezovAdvance_11"),
                    GetNavPointBehPos("BerezovAdvance_12"),
                    GetNavPointBehPos("BerezovAdvance_13"),
                    GetNavPointBehPos("BerezovAdvance_14"),
                    GetNavPointBehPos("BerezovAdvance_15"),
                    GetNavPointBehPos("BerezovAdvance_16"),
                    GetNavPointBehPos("BerezovAdvance_17"),
                    GetNavPointBehPos("BerezovAdvance_18"),
                    GetNavPointBehPos("BerezovAdvance_19"),
                    GetNavPointBehPos("BerezovAdvance_20"),
                    GetNavPointBehPos("BerezovAdvance_21"),
                    GetNavPointBehPos("BerezovAdvance_22"),
                    GetNavPointBehPos("BerezovAdvance_23"),
                    GetNavPointBehPos("BerezovAdvance_24"),
                    GetNavPointBehPos("BerezovAdvance_25"),
                    GetNavPointBehPos("BerezovAdvance_26"),
                    GetNavPointBehPos("BerezovAdvance_27"),
                    GetNavPointBehPos("BerezovAdvance_28"),
                    GetNavPointBehPos("BerezovAdvance_29"),
                    GetNavPointBehPos("BerezovAdvance_30"),
                    GetNavPointBehPos("BerezovAdvance_31"),
                    GetNavPointBehPos("BerezovAdvance_32"),
                    GetNavPointBehPos("BerezovAdvance_33"),
                    GetNavPointBehPos("BerezovAdvance_34")
                           ];

    SetFirstQueueOrders([
      ["StartFirstAdvance", "SetOrder_MoveToEx", [ApproachPoints, TankAttackSpeed], ""],
      ["StartFirstAdvance", "EndFirstAdvance_Attack", [], ""]
                        ]);
  }

  void EndFirstAdvance_Attack()
  {
    m_EnemyReactionType == ERT_AGGRESSIVE;
    SetFormation("CFrontFormation", 50, true, true);
    ActivateRadar(true);
  }
}

class BerezovHQ extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }
}

