class BerezovPltOleshev extends CBaseUnitGroup
{
  void Init()
  {
    CBaseUnitGroup::Init();
    ForEachUnitTask("ActivateBehavior", [true]);
    ActivateRadar(true);
    m_EnemyReactionType == ERT_AGGRESSIVE;
  }

  // Called from CBerezovMission::OnObjectDestroyed once Plt.Kutuzov's
  // KillList hits zero - matches the real mission's "CG State: Plt.Kutuzov
  // destroyed" trigger (reinforcement moving up to Berezov).
  void TriggerAdvance()
  {
    sendEvent(570.0, getIdentificator(this), "StartAdvance", []);
  }

  void StartAdvance()
  {
    SetOrder_MoveToEx([ new Vector(2150.0, 6328.0, 610.0) ], 10.0f);
  }
}
