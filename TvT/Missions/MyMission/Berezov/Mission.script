class CBerezovKurskMission extends CSPMission
{
  Component BerezovKurskFirstContact;
  Component BerezovKurskDeepContact;

  //
  // Contruction and initialization
  //

  String  m_LocalTime       = "14:20:00";
  String m_TerrainMapTextureName = "Textures/C1M3_Map.tex";

  static String m_MissionBriefingPicMaterial = "C1M3BriefingPic";

  Array  m_MissionObjectives = [
      [MOTID_Primary,   CBerezovKurskMission_Strings::Objective01, MOSID_InProgress, true],
      [MOTID_Primary,   CBerezovKurskMission_Strings::Objective02, MOSID_InProgress, true],
      [MOTID_Secondary, CBerezovKurskMission_Strings::Objective03, MOSID_InProgress, true]
          ];

  boolean isDebug = true;

  Array m_NavpointsForPlayerMap = [
    [
      ["GonkiObjective"],
      CBaseCockpitTerrainMap::NAV_RENDER_Default,
      new Color(244.0/255.0, 255.0/255.0, 215.0/255.0)
    ]
  ];

  float  CockpitMapMinRange  = 2000.0;
  float  CockpitMapMaxRange  = 9000.0;
  int    CockpitMapZoomSteps = 10;
  Vector MarksInitPoint      = new Vector(3000.0, 6000.0, 0.0);
  float  CockpitMapNavNameMaxRange  = 4000.0;
  Array  CockpitMapAccessBox  = [ new Vector(0.0, 3000.0, 0.0), new Vector(8000.0, 8000.0, 0.0)];

  // Objective 0: Take Gonki (primary) - completed on MainPlayerUnit reaching
  //   GonkiObjective, see OnObjectEnterNavPoint. Folds in the original PE
  //   mission's bonus objective ("Zug Falke reaches Gonki") since TvT's own
  //   m_MissionObjectives only has Primary/Secondary tiers, no Bonus.
  // Objective 1: Destroy Soviet HQ (primary)
  Array KillList_SovietHQ = [
      "BerezovKursk_SovietHQ_1", "BerezovKursk_SovietHQ_2", "BerezovKursk_SovietHQ_3"
      ];
  // Objective 2: Destroy Plt.Samsonov (secondary)
  Array KillList_PltSamsonov = [
      "BerezovKursk_PltSamsonov_1", "BerezovKursk_PltSamsonov_2", "BerezovKursk_PltSamsonov_3", "BerezovKursk_PltSamsonov_4"
      ];

  final static Array RouterWorkingZones = [
    [40000.0, 40000.0, 60000.0, 60000.0]
                                          ];

  final static Array   DefaultMask = [["ENEMY", "MainMesh"], ["NEUTRAL"]];
  final static Array          Mask = [["ENEMY", "MainMesh"], ["NEUTRAL", "InvisibleOnRadar"]];



  boolean OnTarg = false;
  boolean TigerAggr = false;

  boolean MainPlayerStart = false;
  boolean Combat = false;

  void CBerezovKurskMission()
  {
    BerezovKurskFirstContact = new BerezovKurskFirstContact();
    BerezovKurskFirstContact.Initialize(this, "BerezovKurskFirstContact");
    BerezovKurskDeepContact = new BerezovKurskDeepContact();
    BerezovKurskDeepContact.Initialize(this, "BerezovKurskDeepContact");

    // Construct mission
    CSPMission("CBerezovKurskMission", "BerezovKurskContent");

    // Set mission properties
    SetMissionTerrain(new #ChunkedTerrain<CBerezovKurskTerrain>());
    SetMissionAtmosphere(new #Atmosphere<BerezovKurskAtmosphere>());
    SetMissionSky(new #SkyObject<CSkyModel>());

    if (CDebugSettings::LoadForest)
      SetMissionForest(new CSTBaseForestC1(GetMissionAtmosphere()));
    if (CDebugSettings::LoadRoads)
      SetMissionRoadsParms(new CBaseRoadC1());
    if (CDebugSettings::LoadGrass)
      RegisterObject("Grass", new #Grass<CBaseGrassC1>());


    SetMissionWorldMatrices(new #WorldMatrices<BerezovKurskWorldMatrices>(), [
        [ LAYER_TERRAIN_NAME, "BerezovKurskLandscapeLayer"   ],
        [ LAYER_TERRAIN_ZONE, "BerezovKurskTerrainZoneLayer" ],
        [ LAYER_ROUTER_ZONE,  "BerezovKurskRouterZoneLayer"     ],
        [ LAYER_MICROTEXTURE_MAP1, "BerezovKurskMicroTextures1" ],
        [ LAYER_TERRAIN_WATERHEIGHTS, "BerezovKurskWaterHeights"]
      ]);

    SetRouterPrecalculatedGraph(
      new #RouterPrecalculatedGraph<CRouterPrecalculatedGraph>());

    SetRouterMap("RouterMap_Layer1", new #RouterMap<CC1RouterMap>(), 64, RouterWorkingZones);
  }

// TODO

  String GetMainRadioHomePoint()
  {
    return "";
  }

  void StartMission()
  {
    // call inherited
    CSPMission::StartMission();

   Component console = new #GameController().GetObject(SOID_Console);
//   console.disablebeh();
   //console.showbehinf(true);

    sendEvent(5.0, SOID_MissionController, "StartCombat", []);
  }

  event void StartCombat()
  {
    if (Combat)
      return;

    Combat = true;

    sendEvent(0.0, "BerezovKurskZugFalke", "StartFirstAdvance", []);
    sendEvent(1.0, "BerezovKurskKGKaiser", "StartFirstAdvance", []);
    sendEvent(2.0, "BerezovKurskZugLex", "StartFirstAdvance", []);
    sendEvent(3.0, "BerezovKurskZugWeidinger", "StartFirstAdvance", []);
  }

  void OnObjectEnterNavPoint(String _NavPointID, String _ObjectID)
  {
    if ((_NavPointID == "GonkiObjective") && (_ObjectID == "MainPlayerUnit"))
    {
      SetObjectiveStatus(0, MOSID_Completed);
      sendEvent(1.0, getIdentificator(this), "CloseMission", [MOSID_Completed]);
    }
  }

  void OnObjectLeaveNavPoint(String _NavPointID, String _ObjectID)
  {
  }

  event void OnObjectDestroyed(String _ObjectID)
  {
    CMission::OnObjectDestroyed(_ObjectID);

    int _indexHQ       = KillList_SovietHQ.find(_ObjectID);
    int _indexSamsonov = KillList_PltSamsonov.find(_ObjectID);

    if (_indexHQ != -1)
    {
      KillList_SovietHQ.remove(_indexHQ);
      if (KillList_SovietHQ.size() == 0)
        SetObjectiveStatus(1, MOSID_Completed);
    }

    if (_indexSamsonov != -1)
    {
      KillList_PltSamsonov.remove(_indexSamsonov);
      if (KillList_PltSamsonov.size() == 0)
        SetObjectiveStatus(2, MOSID_Completed);
    }
  }

  void Shutdown()
  {

    CSPMission::Shutdown();
  }
 }
