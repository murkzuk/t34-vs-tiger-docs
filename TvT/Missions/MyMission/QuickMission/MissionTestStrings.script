//-----------------
//  Mission strings - static file (not regenerated per-run). Reads from
//  eng.locale's own dedicated [QuickMissionGenerated] section, which
//  generate_mission.py rewrites every run with a computed scout report -
//  never the shared [MissionTest] section Mission1 itself depends on.
//  Deliberately uses getLocalized() rather than literal WString values -
//  confirmed (2026-07-03) that literal WString static fields are not
//  reliably found by getStaticClassMember()'s reflection, unlike every
//  other real mission's Strings class, which always uses getLocalized().
//-----------------
class CQuickMissionMission_Strings extends CCommonStrings
{
  final static WString MissionName  = getLocalized("QuickMissionGenerated", "MissionName");
  final static WString BriefingText = getLocalized("QuickMissionGenerated", "BriefingText");
  final static WString Objective01  = getLocalized("QuickMissionGenerated", "Objective01");
  final static WString Objective02  = getLocalized("QuickMissionGenerated", "Objective02");
  final static WString Objective03  = getLocalized("QuickMissionGenerated", "Objective03");
}
